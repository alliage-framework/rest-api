{
  "name": "@alliage/rest-api",
  "version": "1.0.0-beta.11",
  "description": "Alliage module to easily build REST APIs",
  "files": [
    "README.md",
    "LICENSE",
    "dist",
    "base-files"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": "https://github.com/alliage-framework/rest-api.git",
  "author": "Boris LEBON <bo.lebon@gmail.com>",
  "license": "MIT",
  "scripts": {
    "download-openapi-schema": "sh scripts/download-openapi-schema.sh",
    "lint": "eslint . --ext .ts",
    "test:unit": "__ALLIAGE_REST_API_MODULE_PATH__=\"$PWD/src\" NODE_ENV=test vitest run --coverage",
    "test:integration": "NODE_ENV=test vitest run --config ./integration-tests/vitest.config.ts",
    "test": "yarn lint && yarn test:unit",
    "clean": "rm -rf ./dist",
    "build": "yarn clean && tsc -p tsconfig.build.json",
    "semantic-release": "semantic-release"
  },
  "alliageManifest": {
    "type": "module",
    "dependencies": [
      "@alliage/builder",
      "@alliage/config-loader",
      "@alliage/di",
      "@alliage/lifecycle",
      "@alliage/process-manager",
      "@alliage/module-installer",
      "@alliage/webserver"
    ],
    "installationProcedures": {
      "copyFiles": [
        [
          "base-files/main-config.yaml",
          "config/rest-api.yaml"
        ],
        [
          "base-files/openapi-specs-config.yaml",
          "config/rest-api-openapi-specs.yaml"
        ]
      ]
    }
  },
  "devDependencies": {
    "@alliage/builder": "^0.1.0-beta.6",
    "@alliage/config-loader": "^0.1.0-beta.6",
    "@alliage/core": "^0.1.0-beta.3",
    "@alliage/di": "^0.1.0-beta.6",
    "@alliage/framework": "^1.0.0-beta.4",
    "@alliage/lifecycle": "^0.1.0-beta.6",
    "@alliage/module-installer": "^0.1.0-beta.6",
    "@alliage/process-manager": "^0.1.0-beta.6",
    "@alliage/sandbox": "^1.0.0-beta.4",
    "@alliage/service-loader": "^0.1.0-beta.6",
    "@alliage/typescript": "^1.0.0-beta.5",
    "@alliage/webserver": "^0.1.0-beta.1",
    "@alliage/webserver-express": "^0.1.0-beta.1",
    "@alliage/webserver-sandbox": "^0.1.0-beta.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^9.27.0",
    "express": "^5.1.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "json-schema": "^0.4.0",
    "json-schema-to-typescript": "^15.0.4",
    "json2ts": "^0.0.7",
    "prettier": "^3.5.3",
    "quicktype": "^23.2.6",
    "semantic-release": "^24.2.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "comment-parser": "^1.4.1",
    "json-schema-to-ts": "^3.1.1",
    "path-to-regexp": "^8.2.0",
    "ts-morph": "^26.0.0"
  },
  "peerDependencies": {
    "@alliage/typescript": "^1.0.0-beta.5",
    "@alliage/webserver": "^0.1.0-beta.1"
  }
}
